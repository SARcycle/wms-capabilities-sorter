# wms-capabilities-sorter: refresh the sorted GetCapabilities document hourly.
#
# Install with:  sudo crontab -e   (root, because /var/www/html is
# normally root-owned), then add the line below.
#
# Runs at minute 7 of every hour to avoid the load peak at the full hour.
# Only errors are logged. In crontab lines, '%' must be escaped as '\%'.
#
# m h dom mon dow command
7 * * * * /usr/bin/python3 /usr/local/bin/wms_capabilities_sorter.py --url "https://wms.geo.admin.ch/?SERVICE=WMS&VERSION=1.3.0&REQUEST=GetCapabilities" --output /var/www/html/swisstopo_wms_getcapabilities.xml >> /var/log/wms_capabilities_sorter.log 2>&1
